<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_community">

    <fragment
        android:id="@+id/nav_community"
        android:name="com.ourcat.app.fragments.ForumFragment"
        android:label="@string/title_community" />

    <fragment
        android:id="@+id/nav_square"
        android:name="com.ourcat.app.fragments.SquareFragment"
        android:label="@string/title_square" />
    <fragment
        android:id="@+id/nav_me"
        android:name="com.ourcat.app.fragments.ProfileFragment"
        android:label="@string/title_me" />
    <fragment
        android:id="@+id/post_detail"
        android:name="com.ourcat.app.fragments.PostDetailFragment"
        android:label="帖子详情">
        <argument
            android:name="postId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/message_center"
        android:name="com.ourcat.app.fragments.MessageCenterFragment"
        android:label="消息中心" />
    <fragment
        android:id="@+id/create_edit_post"
        android:name="com.ourcat.app.fragments.CreateEditPostFragment"
        android:label="发帖">
        <argument
            android:name="editPostId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>
    <fragment
        android:id="@+id/user_management"
        android:name="com.ourcat.app.fragments.UserManagementFragment"
        android:label="用户管理" />
    <fragment
        android:id="@+id/search_result"
        android:name="com.ourcat.app.fragments.SearchResultFragment"
        android:label="搜索结果">
        <argument
            android:name="query"
            app:argType="string"
            android:defaultValue="" />
    </fragment>
    <fragment
        android:id="@+id/my_posts"
        android:name="com.ourcat.app.fragments.MyPostsFragment"
        android:label="我的帖子" />
    <fragment
        android:id="@+id/my_comments"
        android:name="com.ourcat.app.fragments.MyCommentsFragment"
        android:label="我的评论" />
</navigation>
