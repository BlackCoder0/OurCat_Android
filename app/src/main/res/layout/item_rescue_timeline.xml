<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/timeline_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_timeline_dot"
        app:layout_constraintBottom_toBottomOf="@id/timeline_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/timeline_title" />

    <View
        android:id="@+id/timeline_top_line"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#CCCCCC"
        app:layout_constraintBottom_toTopOf="@id/timeline_dot"
        app:layout_constraintEnd_toEndOf="@id/timeline_dot"
        app:layout_constraintStart_toStartOf="@id/timeline_dot"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/timeline_bottom_line"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#CCCCCC"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/timeline_dot"
        app:layout_constraintStart_toStartOf="@id/timeline_dot"
        app:layout_constraintTop_toBottomOf="@id/timeline_dot" />

    <TextView
        android:id="@+id/timeline_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/timeline_dot"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/timeline_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/timeline_title"
        app:layout_constraintStart_toStartOf="@id/timeline_title"
        app:layout_constraintTop_toBottomOf="@id/timeline_title" />

    <TextView
        android:id="@+id/timeline_operator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/timeline_title"
        app:layout_constraintStart_toStartOf="@id/timeline_title"
        app:layout_constraintTop_toBottomOf="@id/timeline_time"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
