<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FFF4E5D2"
                android:startColor="#FFFDF7EE" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:drawable="@drawable/ill_home_wood_grain"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp" />

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#10FFF9F0" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
