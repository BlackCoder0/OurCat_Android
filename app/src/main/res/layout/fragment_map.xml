<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 高德地图（TextureMapView 避免 GLThread 崩溃） -->
        <com.amap.api.maps.TextureMapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 右侧工具栏 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp">

            <!-- 定位按钮 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="定位"
                android:src="@android:drawable/ic_menu_mylocation"
                app:fabSize="mini"
                app:backgroundTint="@color/fab_bg_tint_action"
                app:tint="@color/fab_icon_tint_action" />

            <!-- 刷新按钮 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="刷新"
                android:src="@android:drawable/ic_popup_sync"
                app:fabSize="mini"
                app:backgroundTint="@color/fab_bg_tint_action"
                app:tint="@color/fab_icon_tint_action" />

            <!-- 热力图切换按钮 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_heatmap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="热力图"
                android:src="@drawable/fire_alert"
                app:fabSize="mini"
                app:backgroundTint="@color/fab_bg_tint_toggle"
                app:tint="@color/fab_icon_tint_toggle" />

            <!-- 推荐按钮 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_recommend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="推荐区域"
                android:src="@android:drawable/ic_menu_compass"
                app:fabSize="mini"
                app:backgroundTint="@color/fab_bg_tint_toggle"
                app:tint="@color/fab_icon_tint_toggle" />

            <!-- 宠物医院按钮 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_hospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="宠物医院"
                android:src="@drawable/hospital_building"
                app:fabSize="mini"
                app:backgroundTint="@color/fab_bg_tint_toggle"
                app:tint="@color/fab_icon_tint_toggle" />
        </LinearLayout>

        <!-- 左上角信息面板 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp">

            <!-- 猫咪数量指示 -->
            <TextView
                android:id="@+id/map_cat_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_map_info_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:elevation="4dp"
                android:text="加载中..." />

            <!-- 当前模式指示 -->
            <TextView
                android:id="@+id/map_mode_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_map_mode_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:elevation="4dp"
                android:visibility="gone"
                android:drawableStart="@drawable/fire_alert"
                android:drawableTint="@android:color/white"
                android:drawablePadding="4dp"
                android:text=" 热力图模式" />
        </LinearLayout>

    </FrameLayout>

    <!-- 推荐面板 BottomSheet -->
    <LinearLayout
        android:id="@+id/bottom_sheet_recommend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:padding="16dp"
        android:elevation="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp">

        <!-- 拖动指示条 -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle"
            android:layout_marginBottom="12dp" />

        <!-- 标题和切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/recommend_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=" 猫咪活跃区域 Top5"
                android:drawableStart="@drawable/cat"
                android:drawableTint="@color/primary"
                android:drawablePadding="8dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/recommend_type_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_high"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正序"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_low"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="倒序"
                    style="@style/Widget.MaterialComponents.Chip.Choice" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- 推荐列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recommend_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxHeight="280dp"
            android:nestedScrollingEnabled="true" />

        <!-- 空状态 -->
        <TextView
            android:id="@+id/recommend_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无数据，请先上报猫咪位置"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 上报按钮 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/map_fab_report"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="上报猫咪位置"
        app:srcCompat="@android:drawable/ic_input_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
