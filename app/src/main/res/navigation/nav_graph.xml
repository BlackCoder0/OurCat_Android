<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_community">

    <fragment
        android:id="@+id/nav_community"
        android:name="com.ourcat.app.fragments.RescueHomeFragment"
        android:label="@string/title_community" />

    <fragment
        android:id="@+id/forum_list"
        android:name="com.ourcat.app.fragments.ForumFragment"
        android:label="@string/title_forum" />

    <fragment
        android:id="@+id/nav_square"
        android:name="com.ourcat.app.fragments.SquareFragment"
        android:label="@string/title_square" />

    <fragment
        android:id="@+id/square_detail"
        android:name="com.ourcat.app.fragments.SquareDetailFragment"
        android:label="广播详情">
        <argument
            android:name="squarePostId"
            app:argType="long" />
        <action
            android:id="@+id/action_square_detail_to_cat_profile"
            app:destination="@id/cat_profile" />
        <action
            android:id="@+id/action_square_detail_to_rescue_detail"
            app:destination="@id/rescue_detail" />
    </fragment>

    <fragment
        android:id="@+id/create_square_post"
        android:name="com.ourcat.app.fragments.CreateSquarePostFragment"
        android:label="发布广播" />

    <fragment
        android:id="@+id/nav_cats"
        android:name="com.ourcat.app.fragments.CatsListFragment"
        android:label="@string/title_cats" />

    <fragment
        android:id="@+id/nav_org"
        android:name="com.ourcat.app.fragments.OrgFragment"
        android:label="@string/title_org" />

    <fragment
        android:id="@+id/nav_me"
        android:name="com.ourcat.app.fragments.ProfileFragment"
        android:label="@string/title_me" />

    <fragment
        android:id="@+id/post_detail"
        android:name="com.ourcat.app.fragments.PostDetailFragment"
        android:label="帖子详情">
        <argument
            android:name="postId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/message_center"
        android:name="com.ourcat.app.fragments.MessageCenterFragment"
        android:label="消息中心" />

    <fragment
        android:id="@+id/create_edit_post"
        android:name="com.ourcat.app.fragments.CreateEditPostFragment"
        android:label="发帖">
        <argument
            android:name="editPostId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>

    <fragment
        android:id="@+id/user_management"
        android:name="com.ourcat.app.fragments.UserManagementFragment"
        android:label="用户管理" />

    <fragment
        android:id="@+id/search_result"
        android:name="com.ourcat.app.fragments.SearchResultFragment"
        android:label="搜索结果">
        <argument
            android:name="query"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/my_posts"
        android:name="com.ourcat.app.fragments.MyPostsFragment"
        android:label="我的帖子" />

    <fragment
        android:id="@+id/my_comments"
        android:name="com.ourcat.app.fragments.MyCommentsFragment"
        android:label="我的评论" />

    <fragment
        android:id="@+id/my_cat_reports"
        android:name="com.ourcat.app.fragments.MyCatReportsFragment"
        android:label="我的上报" />

    <fragment
        android:id="@+id/user_profile"
        android:name="com.ourcat.app.fragments.UserProfileFragment"
        android:label="个人主页">
        <argument
            android:name="userId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/cat_profile"
        android:name="com.ourcat.app.fragments.CatProfileFragment"
        android:label="猫咪档案">
        <argument
            android:name="catId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/rescue_list"
        android:name="com.ourcat.app.fragments.RescueListFragment"
        android:label="救助动态" />

    <fragment
        android:id="@+id/rescue_detail"
        android:name="com.ourcat.app.fragments.RescueDetailFragment"
        android:label="救助活动详情">
        <argument
            android:name="activityId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/my_tasks"
        android:name="com.ourcat.app.fragments.MyTasksFragment"
        android:label="我的任务" />

    <fragment
        android:id="@+id/rescue_statistics"
        android:name="com.ourcat.app.fragments.RescueStatisticsFragment"
        android:label="救助统计" />

    <fragment
        android:id="@+id/rescue_guide"
        android:name="com.ourcat.app.fragments.RescueGuideFragment"
        android:label="救助指南" />

    <fragment
        android:id="@+id/rescue_knowledge"
        android:name="com.ourcat.app.fragments.RescueKnowledgeFragment"
        android:label="救助知识" />

    <fragment
        android:id="@+id/rescue_article_detail"
        android:name="com.ourcat.app.fragments.RescueArticleDetailFragment"
        android:label="文章详情">
        <argument
            android:name="articleId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

    <fragment
        android:id="@+id/org_fragment"
        android:name="com.ourcat.app.fragments.OrgFragment"
        android:label="组织" />

    <fragment
        android:id="@+id/join_requests"
        android:name="com.ourcat.app.fragments.JoinRequestsFragment"
        android:label="加入申请审核" />
</navigation>
