<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_community">

    <fragment
        android:id="@+id/nav_community"
        android:name="com.ourcat.app.fragments.ForumFragment"
        android:label="@string/title_community" />
    <fragment
        android:id="@+id/nav_map"
        android:name="com.ourcat.app.fragments.MapFragment"
        android:label="@string/title_map" />
    <fragment
        android:id="@+id/nav_square"
        android:name="com.ourcat.app.fragments.SquareFragment"
        android:label="@string/title_square" />
    <fragment
        android:id="@+id/nav_me"
        android:name="com.ourcat.app.fragments.ProfileFragment"
        android:label="@string/title_me" />
    <fragment
        android:id="@+id/post_detail"
        android:name="com.ourcat.app.fragments.PostDetailFragment"
        android:label="帖子详情">
        <argument
            android:name="postId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/message_center"
        android:name="com.ourcat.app.fragments.MessageCenterFragment"
        android:label="消息中心" />
</navigation>
